# ===== Atomic Server 部署配置 =====
# 复制此文件为 .env 并填入实际值

# ===== 基础配置 =====
# 公共访问 URL（留空则自动检测）
PUBLIC_URL=http://10.70.0.52:8080

# 设置令牌（首次访问时验证）
ATOMIC_SETUP_TOKEN=

# ===== AI Provider 配置 =====
# 可选值: openrouter, ollama, openai_compat
PROVIDER=openrouter

# OpenRouter API Key 从数据库读取，无需在此配置
# （数据迁移后自动使用原服务器的 Key）

# Ollama 配置（本地 AI）
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_LLM_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ===== OCR 服务 =====
# OCR 服务地址（已在 10.70.0.52 运行）
TESSERACT_HOST=http://10.70.0.52:8080
PADDLEOCR_HOST=http://10.70.0.52:8081

# ===== CORS =====
# 允许所有来源（仅用于信任的环境）
ALLOW_ALL_CORS=true

# ===== SQLite 性能调优 =====
ATOMIC_SERVER_READ_POOL_SIZE=16
ATOMIC_SQLITE_CACHE_KB=64000
ATOMIC_SQLITE_READ_CACHE_KB=8000

# ===== Litestream 备份（可选）=====
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# LITESTREAM_BUCKET=
# LITESTREAM_ENDPOINT=
# LITESTREAM_PATH=atomic